# Red Portal — merged request bot env vars
# Set these as environment variables on the host (Koyeb). NONE of these belong
# in the repo. Copy to a local .env for dev (that file is gitignored).
#
# The bot is fully OPTIONAL: with none of these set, the website runs exactly as
# before and the bot stays dormant.

# --- Discord gateway (the /request slash command) ---
BOT_TOKEN=                 # Discord bot token
GUILD_ID=                  # Discord server (guild) id
REQUEST_CHANNEL_ID=        # channel id where /request posts embeds

# --- Notifications + pipeline ---
DISCORD_WEBHOOK=           # channel webhook URL for bot notifications
GITHUB_TOKEN=              # optional: raises GitHub search rate limit (60->5000/hr)

# --- R2 WRITE credentials (to upload crawled games) ---
# These are the WRITE keys, distinct from the server's read-only R2_LIST_* keys.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Non-secret (have public defaults; override only if they change) ---
# R2_BUCKET=red-portal-assets
# R2_PUBLIC_DOMAIN=assets.redportal.dpdns.org
# GITHUB_USERNAME=VVVULTURE
# RED_PORTAL_OWNER=VVVULTURE
# RED_PORTAL_REPO=red-portal-DKR-LCL
# RED_PORTAL_BRANCH=main
# PROXY_URL=https://redportal.dpdns.org/rp/
# LOCAL_REPO_PATH=   # defaults to an OS temp dir; games are written+uploaded then discarded
