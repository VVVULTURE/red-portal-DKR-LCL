.sync_state.json
manifest.json
skipped.log

# Editor/OS noise
.DS_Store
Thumbs.db

# Theme depth layers live on R2 (uploaded from the sync folder). Local
# copies under assets/themes/<Folder>/ are for testing only.
assets/themes/*/

# local playwright link for tools/ui-harness
node_modules_pw/

__pycache__/
*.pyc

# Secrets — never commit
.env
.env.*
